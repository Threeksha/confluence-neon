
<div id="confluence-animation-root" hidden></div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initConfluenceAnimations() {
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (reduceMotion) return;

    const hero = document.querySelector('.hero-copy');
    const planet = document.querySelector('.planet');
    const rings = document.querySelectorAll('.ring');
    const cards = document.querySelectorAll('.theme-card');
    const milestones = document.querySelectorAll('.milestone');
    const sections = document.querySelectorAll('.section-label');

    // Entrance animation for the hero text.
    if (hero) {
      gsap.fromTo(
        hero,
        { autoAlpha: 0, y: 35 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 1.1,
          ease: 'power3.out',
          delay: 0.15
        }
      );
    }

    // Extra floating motion for the holographic planet.
    if (planet) {
      gsap.to(planet, {
        y: -12,
        duration: 2.8,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut'
      });
    }

    // Reveal theme cards when they enter the viewport.
    if (cards.length) {
      gsap.fromTo(
        cards,
        { autoAlpha: 0, y: 35 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.7,
          stagger: 0.12,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '.theme-grid',
            start: 'top 85%',
            once: true
          }
        }
      );
    }

    // Reveal timeline milestones in sequence.
    if (milestones.length) {
      gsap.fromTo(
        milestones,
        { autoAlpha: 0, y: 20 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.6,
          stagger: 0.1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '.timeline',
            start: 'top 85%',
            once: true
          }
        }
      );
    }

    // Subtle reveal for section labels.
    if (sections.length) {
      gsap.fromTo(
        sections,
        { autoAlpha: 0, x: -15 },
        {
          autoAlpha: 1,
          x: 0,
          duration: 0.6,
          stagger: 0.08,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '.about',
            start: 'top 85%',
            once: true
          }
        }
      );
    }

    ScrollTrigger.refresh();
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initConfluenceAnimations,
      { once: true }
    );
  } else {
    initConfluenceAnimations();
  }
</script>
