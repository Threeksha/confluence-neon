  .phase-label {
    display: block;
    margin: 0 0 10px;
    color: #c49aff;
    font: 9px 'DM Mono', monospace;
    letter-spacing: 1.4px;
  }

  .milestone h3 {
    font-size: 13px;
    line-height: 1.5;
    color: #f6f5ff;
  }

  .milestone > p {
    font-size: 11px;
    line-height: 1.8;
    color: #aab0cb;
  }

  .phase-outcome {
    display: grid;
    gap: 7px;
    margin-top: 14px;
    padding: 12px;
    text-align: left;
    border: 1px solid #8d71ff40;
    border-radius: 9px;
    background: #111329;
  }

  .phase-outcome strong {
    font: 9px 'DM Mono', monospace;
    letter-spacing: 1px;
    color: #62dcff;
  }

