  }
  .themes .theme-card:nth-child(2n) .art-network-lines { animation-delay: -2s, -1.3s; animation-duration: 11s, 6s; }
  .themes .theme-card:nth-child(3n) .art-network-lines { animation-delay: -4.5s, -2.2s; animation-duration: 12.5s, 7s; }
  .themes .theme-card .art-network-nodes circle {
