  }

  @media (max-width: 680px) {
    .event-detail-grid { grid-template-columns: 1fr; gap: 12px; }
    .event-detail-card { padding: 20px; }
    .section-title-row:has(.prize-pill) { align-items: stretch; }
    .prize-pill { text-align: left; width: 100%; }
    .real-world { grid-template-columns: 1fr; gap: 15px; }
    .impact-visual { min-height: 245px; }
  }

  /* Micro-interactions */
  .menu-toggle {
    display: none;
    width: 42px;
    height: 42px;
    padding: 10px;
    border: 1px solid #8d71ff60;
    border-radius: 10px;
    background: #101127;
    color: #f6f5ff;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    transition: border-color .25s ease, background .25s ease, transform .25s ease;
  }
  .menu-toggle:hover { border-color: #bd8aff; background: #1a1530; }
  .menu-toggle:active { transform: scale(.95); }
  .menu-toggle span {
    display: block;
    width: 19px;
    height: 2px;
    border-radius: 2px;
    background: #e6d9ff;
    transition: transform .25s ease, opacity .2s ease;
  }
  .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-7px) rotate(-45deg); }

  .button, .nav-cta, .card-bottom > a, .participation-card {
    will-change: transform;
  }
  .button:focus-visible, .nav-cta:focus-visible, nav a:focus-visible,
  .menu-toggle:focus-visible, .faq-list summary:focus-visible {
    outline: 2px solid #55ddff;
    outline-offset: 4px;
  }
  .nav-cta { transition: transform .25s ease, box-shadow .25s ease, filter .25s ease; }
  .nav-cta:hover { transform: translateY(-2px); box-shadow: 0 0 30px #7c3dff9c; filter: brightness(1.08); }
  .button:active, .nav-cta:active { transform: translateY(0) scale(.98); }

  .faq-list summary span {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    transition: transform .25s ease, color .25s ease;
  }
  .faq-list details[open] summary span { color: #55ddff; transform: rotate(180deg); }
  .faq-list details p { margin-top: 0; }

  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity .65s ease, transform .65s cubic-bezier(.2,.7,.2,1);
  }
  .reveal-on-scroll.is-visible { opacity: 1; transform: translateY(0); }
  html { scroll-behavior: smooth; }
  section[id] { scroll-margin-top: 88px; }

