  /* THEME IMAGES — autonomous left-to-right cinematic pan (no moving light effects) */
  .themes .theme-card .card-art {
    animation: none !important;
    overflow: hidden !important;
    isolation: isolate;
    background: #080b18;
  }
  /* Remove all sweeping/atmospheric lighting overlays. */
  .themes .theme-card .card-art::before {
    content: none !important;
    display: none !important;
    animation: none !important;
  }
  .themes .theme-card .card-art img {
    position: absolute !important;
    top: 0 !important;
    left: -8% !important;
    width: 116% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center center !important;
    opacity: .82 !important;
    filter: saturate(1.08) contrast(1.04) brightness(.86) !important;
