  .concept-heading-wrap{position:relative;isolation:isolate;width:max-content;max-width:100%;padding:12px 0 18px}
  .concept-heading{position:relative;z-index:2;font-size:clamp(2.6rem,5.2vw,5.1rem)!important;line-height:.98!important;letter-spacing:-.065em!important;font-weight:800!important}
