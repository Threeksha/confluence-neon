    animation: theme-atmosphere-drift 12s ease-in-out infinite alternate;
    transform: translate3d(-3%, 1%, 0) scale(1.04);
  }
  .themes .theme-card:nth-child(2n) .card-art::before { animation-delay: -3s; animation-duration: 14s; }
  .themes .theme-card:nth-child(3n) .card-art::before { animation-delay: -6s; animation-duration: 16s; }
  .themes .theme-card .card-art::after {
    content: "";
    position: absolute; z-index: 2; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, #03061110 0%, #05061112 44%, #050611a8 100%),
      radial-gradient(ellipse at 50% 50%, transparent 18%, #05061130 100%);
  }
  .themes .theme-card .art-grid { display: none !important; }
