  @media(max-width:680px){.concept-heading{font-size:clamp(2.4rem,10vw,3.5rem)!important}.concept-word{font-size:clamp(3.15rem,12vw,4.4rem)}.concept-heading-wrap{padding:8px 0 14px}.concept-constellation{left:-12%;width:124%;height:170px}.concept-section .value-list article{padding:12px 5px}.concept-section .value-list b{font-size:9px}.concept-section .value-list small{font-size:8px}}
