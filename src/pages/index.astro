---
import '../styles/confluence.css';
import SiteHeader from '../components/SiteHeader.astro';
import HeroSection from '../components/HeroSection.astro';
import EventDetails from '../components/EventDetails.astro';
import AboutSection from '../components/AboutSection.astro';
import RealWorldSection from '../components/RealWorldSection.astro';
import ThemesSection from '../components/ThemesSection.astro';
import RoadmapSection from '../components/RoadmapSection.astro';
import ParticipateSection from '../components/ParticipateSection.astro';
import FAQSection from '../components/FAQSection.astro';
import RegisterCTA from '../components/RegisterCTA.astro';
import SecretTerminal from '../components/SecretTerminal.astro';
import AdminEasterEgg from '../components/AdminEasterEgg.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050611" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://confluence-neon.vercel.app/" />

    <!-- Page title and SEO description -->
    <title>Confluence 2026 | IEEE CS PESU</title>
    <meta
      name="description"
      content="Discover Confluence 2026 by IEEE CS PESU — a hackathon where curious minds collaborate, build innovative solutions, and turn bold ideas into reality."
    />

    <!-- Open Graph metadata for link previews -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Confluence 2026 | IEEE CS PESU" />
    <meta property="og:title" content="Confluence 2026 | IEEE CS PESU" />
    <meta
      property="og:description"
      content="Build. Collaborate. Converge. Join Confluence 2026 by IEEE CS PESU."
    />
    <meta property="og:url" content="https://confluence-neon.vercel.app/" />
    <meta property="og:locale" content="en_US" />

    <!-- Social preview image -->
    <meta
      property="og:image"
      content="https://confluence-neon.vercel.app/og-confluence.jpg"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Confluence 2026 — IEEE Computer Society PESU"
    />

    <!-- Twitter / X card metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Confluence 2026 | IEEE CS PESU" />
    <meta
      name="twitter:description"
      content="Build. Collaborate. Converge. Join Confluence 2026 by IEEE CS PESU."
    />
    <meta
      name="twitter:image"
      content="https://confluence-neon.vercel.app/og-confluence.jpg"
    />
  </head>

  <body>
    <div class="ambient" aria-hidden="true"></div>

    <SiteHeader />

    <main>
      <HeroSection />
      <EventDetails />
      <AboutSection />
      <RealWorldSection />
      <ThemesSection />
      <RoadmapSection />
      <ParticipateSection />
      <FAQSection />
      <RegisterCTA />
    </main>

    <SecretTerminal />
    <AdminEasterEgg />
    <SiteFooter />

    <script src="../scripts/site-interactions.js"></script>
    <script src="../scripts/concept-reveal.js"></script>
    <script src="../scripts/admin-easter-egg.js"></script>
    <script src="../scripts/concept-motion.js"></script>
    <script src="../scripts/theme-videos.js"></script>
    <script src="../scripts/hero-vortex.js"></script>
  </body>
</html>