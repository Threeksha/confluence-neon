    font-size: 10px;
    line-height: 1.6;
    color: #c5c9de;
  }

  @media (max-width: 680px) {
    .milestone h3 {
      font-size: 12px;
    }

    .phase-outcome {
      padding: 9px;
    }
  }


  /* Cleaner roadmap layout: roomy cards instead of a crowded horizontal timeline */
  .timeline {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-top: 38px;
    position: relative;
  }

  .timeline:before { display: none; }

  .milestone {
    min-width: 0;
    padding: 25px 25px 23px;
    text-align: left;
    border: 1px solid #8d71ff35;
    border-radius: 16px;
    background: linear-gradient(145deg, #14152b 0%, #0d1020 75%);
    box-shadow: 0 10px 30px #00000018;
    transition: transform .25s ease, border-color .25s ease, background .25s ease;
  }

  .milestone:hover {
    transform: translateY(-4px);
    border-color: #a77cff9c;
    background: linear-gradient(145deg, #191832 0%, #0e1425 75%);
  }

  .milestone-node {
    width: 42px;
    height: 42px;
    margin: 0 0 20px;
    border-radius: 12px;
    font-size: 13px;
    background: #1a1530;
  }

  .phase-label { margin-bottom: 8px; font-size: 10px; }
  .milestone h3 { margin: 0 0 10px; font-size: 19px; line-height: 1.35; }
  .milestone > p { margin: 0; font-size: 12px; line-height: 1.8; }

  .phase-outcome {
    margin-top: 19px;
    padding: 13px 15px;
    gap: 6px;
    border-color: #8d71ff30;
    background: #0b0e1b;
  }

  .phase-outcome span { font-size: 11px; line-height: 1.65; }

  @media (max-width: 680px) {
    .timeline { grid-template-columns: 1fr; gap: 14px; margin-top: 28px; }
    .milestone { padding: 21px; }
    .milestone-node { margin-bottom: 16px; }
    .milestone h3 { font-size: 18px; }
    .milestone > p { font-size: 12px; }
    .phase-outcome { padding: 12px 13px; }
  }


  /* Participation section */
  .participate {
    background: radial-gradient(ellipse at 25% 45%, #17113a75, transparent 55%), #070812;
  }

  .participation-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 30px;
  }

  .participation-card {
    min-width: 0;
    padding: 25px;
    border: 1px solid #8d71ff35;
    border-radius: 15px;
    background: linear-gradient(145deg, #14152b 0%, #0d1020 75%);
    transition: transform .25s ease, border-color .25s ease;
  }

  .participation-card:hover {
    transform: translateY(-4px);
    border-color: #a77cff9c;
  }

  .participation-number {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid #8d71ff70;
    border-radius: 11px;
    background: #1a1530;
    color: #c49aff;
    font: 11px 'DM Mono', monospace;
  }

  .participation-card h3 {
    margin: 22px 0 10px;
    font-size: 17px;
    line-height: 1.4;
  }

  .participation-card p {
    margin: 0;
    color: #aab0cb;
    font-size: 12px;
    line-height: 1.85;
  }

  @media (max-width: 680px) {
    .participation-grid {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 22px;
    }

    .participation-card {
      padding: 21px;
    }
  }




  /* Event information and real-world impact sections */
  .event-details {
    background: radial-gradient(ellipse at 80% 20%, #17205465, transparent 48%), #070812;
  }
  .event-detail-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-top: 28px;
  }
  .event-detail-card {
    min-width: 0;
    padding: 24px;
    border: 1px solid #8d71ff40;
    border-radius: 15px;
    background: linear-gradient(145deg, #14152b, #0b0e1b 78%);
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .event-detail-card:hover {
    transform: translateY(-4px);
    border-color: #52dfff9c;
    box-shadow: 0 12px 32px #0005, 0 0 22px #7d5bff20;
  }
  .event-detail-icon { display: block; color: #62dcff; font-size: 27px; margin-bottom: 19px; }
  .event-detail-label, .prize-pill > span {
    display: block; color: #c49aff; font: 10px 'DM Mono', monospace; letter-spacing: 1.6px;
  }
  .event-detail-card h3 { margin: 10px 0 8px; font-size: 17px; line-height: 1.45; }
  .event-detail-card p { margin: 0; color: #aab0cb; font-size: 12px; line-height: 1.8; }
  .prize-pill {
    min-width: 150px; padding: 16px 20px; border: 1px solid #f276f750; border-radius: 13px;
    background: linear-gradient(130deg, #30144390, #101226); text-align: right;
  }
  .prize-pill strong { display: block; margin-top: 5px; font-size: 27px; color: #f0b5ff; text-shadow: 0 0 20px #d65cff45; }
  .real-world {
    display: grid; grid-template-columns: 1fr .85fr; gap: 45px; align-items: center;
    overflow: hidden; background: radial-gradient(ellipse at 80% 50%, #30206a70, transparent 45%), #050611;
  }
  .real-world-copy { max-width: 610px; }
  .real-world-copy h2 { font-size: clamp(38px, 5vw, 64px); }
  .real-world-copy h2 span { color: #62dcff; }
  .real-world-copy p { max-width: 560px; margin: 18px 0 25px; color: #aab0cb; font-size: 13px; line-height: 1.95; }
  .impact-visual { min-height: 280px; position: relative; display: grid; place-items: center; isolation: isolate; }
  .impact-ring { position: absolute; width: 230px; height: 230px; border: 1px solid #9c72ff70; border-radius: 50%; box-shadow: 0 0 35px #7e47ff1f; }
  .impact-ring-one { transform: rotateX(65deg) rotate(-25deg); }
  .impact-ring-two { width: 180px; height: 180px; transform: rotateY(65deg) rotate(25deg); border-color: #52dfff75; }
  .impact-core { z-index: 1; display: flex; align-items: center; gap: 10px; padding: 20px; border: 1px solid #8d71ff70; border-radius: 15px; background: #0b0e1beF; box-shadow: 0 0 40px #714bff30; font: 11px 'DM Mono', monospace; letter-spacing: 1px; }
  .impact-core span { color: #62dcff; font-size: 22px; }
  .impact-tag { position: absolute; padding: 8px 11px; border: 1px solid #8d71ff70; border-radius: 20px; background: #101329; color: #c9c8e8; font: 9px 'DM Mono', monospace; letter-spacing: 1px; }
  .impact-tag-one { top: 16%; left: 8%; }.impact-tag-two { right: 5%; top: 26%; }.impact-tag-three { bottom: 13%; left: 22%; }

  @media (max-width: 1000px) and (min-width: 681px) {
