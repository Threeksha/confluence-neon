  /* VIDEO-LIKE THEME ART — slow cinematic image motion + connected signal paths.
     Replaces the previous shimmer/sweep; keeps the symbol precisely centered. */
  .themes .theme-card .card-art {
    position: relative !important;
    display: grid !important;
    place-items: center !important;
    isolation: isolate;
    overflow: hidden;
    height: clamp(132px, 13vw, 174px);
    border-radius: 12px;
    background: #080b18;
    border: 1px solid color-mix(in srgb, var(--accent), transparent 58%);
    box-shadow: inset 0 0 34px #03040dc9, 0 0 24px color-mix(in srgb, var(--accent), transparent 91%);
    animation: theme-live-frame 7s ease-in-out infinite alternate;
  }
  .themes .theme-card:nth-child(2n) .card-art { animation-delay: -2.4s; }
  .themes .theme-card:nth-child(3n) .card-art { animation-delay: -4s; }
  .themes .theme-card .card-art img {
    position: absolute !important;
    inset: 0;
    z-index: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: .77;
    transform: scale(1.09);
    filter: saturate(1.12) contrast(1.06) brightness(.84);
    animation: theme-footage-pan 16s cubic-bezier(.45,0,.55,1) infinite alternate;
    will-change: transform, filter;
  }
  .themes .theme-card:nth-child(2n) .card-art img { animation-duration: 19s; animation-delay: -5s; }
  .themes .theme-card:nth-child(3n) .card-art img { animation-duration: 22s; animation-delay: -8s; }
  .themes .theme-card .card-art::before {
    /* Gentle moving colour atmosphere — not a bright shimmer beam. */
    content: "" !important;
    display: block !important;
    position: absolute; z-index: 1; inset: -25%; pointer-events: none;
    opacity: .23;
    background:
      radial-gradient(ellipse at 18% 70%, color-mix(in srgb, var(--accent), transparent 42%), transparent 48%),
      radial-gradient(ellipse at 78% 24%, color-mix(in srgb, #65e9ff, transparent 55%), transparent 43%);
