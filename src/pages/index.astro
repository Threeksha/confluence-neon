  .concept-word:after{content:"";position:absolute;left:1%;right:0;bottom:-7px;height:4px;border-radius:99px;background:linear-gradient(90deg,transparent,#bd8aff 20%,#6deaff 80%,transparent);transform:scaleX(.08);transform-origin:left;opacity:0;filter:blur(.6px)}
  .concept-question{display:inline-block;color:#d8b5ff;text-shadow:0 0 18px #a46bff8c;animation:conceptQuestionPulse 3.4s ease-in-out infinite}
  .concept-constellation{position:absolute;z-index:1;pointer-events:none;left:-9%;top:50%;width:118%;height:clamp(150px,21vw,250px);overflow:visible;transform:translateY(-50%);opacity:0.04}
